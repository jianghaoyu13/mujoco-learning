<mujoco model="so_arm100 scene with cube and cameras">
  <include file="so_arm100.xml"/>

  <statistic center="0.15 -0.15 0.1" extent="0.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- 地面接触调硬: 默认 soft 接触下夹爪合拢会把方块压进地面以下(方块中心下沉 ~8-13mm)。加硬后穿透 < 2mm 且抓取/放置稳定。 -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          solref="0.002 0.02" solimp="0.95 0.99 0.99 0.01 0.001"/>

    <!-- Cube object (默认放在源框中心) -->
    <body name="cube" pos="0.21 -0.10 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="1 0 0 1" mass="0.01" friction="3.0 2.0 0.003"/>
    </body>

    <!-- 地面标记方框 (纯视觉, 不参与碰撞):源框 (黄色) / 目标框 (绿色), 均为 0.10m 见方, 半侧 0.05m -->
    <geom name="source_box_marker" type="box" size="0.05 0.05 0.0005"
          pos="0.21 -0.10 0.0005" rgba="1 0.7 0 0.8" contype="0" conaffinity="0"/>
    <geom name="target_box_marker" type="box" size="0.05 0.05 0.0005"
          pos="0.10 -0.10 0.0005" rgba="0 0.85 0.25 0.8" contype="0" conaffinity="0"/>

    <!-- Fixed cameras -->
    <camera name="top_camera" pos="0.1500 -0.1500 0.5000" quat="0.7311 -0.0191 -0.0179 0.6818" mode="fixed"/>
    <camera name="side_camera" pos="0.4063 -0.2189 0.4585" quat="0.6530 0.2713 0.2713 0.6530" mode="fixed"/>
  </worldbody>
</mujoco>